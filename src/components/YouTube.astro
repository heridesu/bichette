---
// Embeds a YouTube video by URL (any common form — watch, youtu.be,
// shorts, or a bare ID). Always 16/9 — YouTube embeds don't offer a
// vertical iframe, even for Shorts.
interface Props {
  url: string;
  caption?: string;
}

const { url, caption } = Astro.props;

function toEmbedId(input: string): string {
  const trimmed = input.trim();
  const patterns = [
    /youtu\.be\/([^?&/]+)/,
    /youtube\.com\/watch\?v=([^&]+)/,
    /youtube\.com\/embed\/([^?&/]+)/,
    /youtube\.com\/shorts\/([^?&/]+)/,
  ];
  for (const re of patterns) {
    const m = re.exec(trimmed);
    if (m) return m[1];
  }
  return trimmed;
}

const id = toEmbedId(url);
---

<figure class="figure">
  <div class="figure__frame figure__frame--video">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${id}`}
      title="YouTube video"
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
  {caption && <figcaption class="figure__caption">{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 1.5rem 0;
  }

  .figure__frame--video {
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .figure__frame--video iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .figure__caption {
    margin-top: 0.5rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
    font-style: italic;
  }
</style>
