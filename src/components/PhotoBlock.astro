---
import type { CollectionEntry } from 'astro:content';
import { responsiveSrcSet } from '../lib/images';

interface Props {
  entry: CollectionEntry<'entries'>;
}

const { entry } = Astro.props;
const { image, imageAlt, aspect, caption, title, tags } = entry.data;
---

<figure class="photo">
  <div class="photo__frame" style={aspect ? `aspect-ratio: ${aspect};` : ''}>
    <img
      src={image}
      srcset={image ? responsiveSrcSet(image) : undefined}
      sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 350px"
      alt={imageAlt ?? title ?? ''}
      loading="lazy"
    />
  </div>
  {(title || caption) && (
    <figcaption class="photo__caption">
      {title && <span class="photo__title">{title}</span>}
      {caption && <span class="photo__text">{caption}</span>}
    </figcaption>
  )}
  {tags && tags.length > 0 && (
    <ul class="photo__tags">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  )}
</figure>

<style>
  .photo {
    margin: 0;
  }

  .photo__frame {
    overflow: hidden;
    background: #eee;
  }

  .photo__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo__caption {
    margin-top: 0.55rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .photo__title {
    font-family: var(--font-serif);
    font-size: 0.92rem;
  }

  .photo__text {
    font-size: 0.82rem;
    color: var(--ink-soft);
    font-style: italic;
  }

  .photo__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.4rem 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--ink-faint);
    text-transform: lowercase;
  }
</style>
