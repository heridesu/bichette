---
// Lets an entry body break out of a single vertical column — a few
// <Figure> images side by side instead of stacked, or (cols={1}) a
// deliberate vertical stack when that's the composition you want.
// Used directly inside MDX bodies:
// <FigureGrid cols={3}><Figure .../><Figure .../></FigureGrid>
interface Props {
  cols?: 1 | 2 | 3 | 4;
  /** 'contact-sheet' forces every cell to a uniform square and drops the
      gap/captions down to a dense, uncomposed archive look — for a pile
      of similar photos you don't want to hand-arrange one by one. */
  style?: 'grid' | 'contact-sheet';
}

const { cols = 2, style = 'grid' } = Astro.props;
---

<div class={`figure-grid${style === 'contact-sheet' ? ' figure-grid--contact-sheet' : ''}`} data-cols={cols}>
  <slot />
</div>

<style>
  .figure-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .figure-grid[data-cols='1'] {
    grid-template-columns: 1fr;
  }

  .figure-grid[data-cols='3'] {
    grid-template-columns: repeat(3, 1fr);
  }

  .figure-grid[data-cols='4'] {
    grid-template-columns: repeat(4, 1fr);
  }

  .figure-grid :global(figure.figure) {
    margin: 0;
  }

  .figure-grid--contact-sheet {
    gap: 0.25rem;
  }

  .figure-grid--contact-sheet :global(.figure__frame) {
    aspect-ratio: 1;
  }

  .figure-grid--contact-sheet :global(.figure__caption) {
    display: none;
  }

  @media (max-width: 640px) {
    .figure-grid[data-cols='3'],
    .figure-grid[data-cols='4'] {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
