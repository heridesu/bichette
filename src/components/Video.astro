---
// Same building block as Figure, for a video instead of a still image.
// `aspect` can't be auto-detected the way an image's can (no cheap way
// to read a video's dimensions without decoding it), so it's optional —
// set it by hand for a vertical (phone-shot) clip, e.g. aspect="9/16",
// or leave it for a landscape one.
interface Props {
  src: string;
  caption?: string;
  aspect?: string;
  size?: 'hero' | 'inline';
}

const { src, caption, aspect, size = 'inline' } = Astro.props;
---

<figure class={`figure figure--${size}`}>
  <div class="figure__frame" style={aspect ? `aspect-ratio: ${aspect};` : ''}>
    <video src={src} controls playsinline preload="metadata" />
  </div>
  {caption && <figcaption class="figure__caption">{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 1.5rem 0;
  }

  .figure__frame {
    overflow: hidden;
    background: var(--line);
    aspect-ratio: 3 / 2;
  }

  .figure__frame video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
    display: block;
  }

  .figure--hero .figure__frame {
    max-height: 85vh;
  }

  .figure__caption {
    margin-top: 0.5rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
    font-style: italic;
  }
</style>
