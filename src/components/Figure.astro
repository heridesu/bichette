---
import { responsiveSrcSet } from '../lib/images';

// Usable both as the lead image on an entry page and inline inside an
// MDX body (directly, or inside <FigureGrid>) — the same building block
// either way, just with a different `size`.
interface Props {
  src: string;
  alt?: string;
  caption?: string;
  aspect?: string;
  size?: 'hero' | 'inline';
  href?: string;
  /** Percentage width within its column; omitted/100 = full width. */
  width?: number;
  /** A thin black line at the frame's outer edge. */
  border?: boolean;
  /** Border thickness in px. Only meaningful when `border` is true.
      Omitted means the long-standing default of 2px. */
  borderWidth?: number;
  /** White padding between the image and the frame's edge — a mat/passe-partout.
      Combines with `border` (the border draws around the mat, not the image). */
  mat?: boolean;
  /** Clicking opens this image full-screen in place (the same lightbox the
      homepage and collage tiles use) instead of following `href` — the
      two are mutually exclusive. */
  lightbox?: boolean;
  /** Focal point (0-100%) for the existing object-fit: cover crop —
   * re-centers which part of the image shows, without touching the
   * original file. Omitted = 50/50, today's exact centered behavior. */
  focalX?: number;
  focalY?: number;
}

const { src, alt = '', caption, aspect, size = 'inline', href, width, border, borderWidth, mat, lightbox, focalX, focalY } = Astro.props;
const Wrap = lightbox ? 'div' : href ? 'a' : 'div';
const wrapAttrs = lightbox
  ? { role: 'button', tabindex: 0, 'data-lightbox-src': src, 'data-lightbox-alt': alt, 'aria-label': 'View image full size' }
  : href
    ? { href, target: href.startsWith('http') ? '_blank' : undefined, rel: href.startsWith('http') ? 'noopener noreferrer' : undefined }
    : {};
const narrow = typeof width === 'number' && width < 100;
const frameClass = `figure__frame${border ? ' figure__frame--bordered' : ''}${mat ? ' figure__frame--matted' : ''}`;
// The hero image is an entry page's lead photo — almost always the
// first/most prominent thing on the page, so it should load promptly
// rather than wait on the lazy-loading observer like everything else.
const isHero = size === 'hero';
const srcset = responsiveSrcSet(src);
---

<figure class={`figure figure--${size}${narrow ? ' figure--narrow' : ''}`} style={narrow ? `width: ${width}%;` : ''}>
  <Wrap
    class={frameClass}
    style={`${aspect ? `aspect-ratio: ${aspect};` : ''}${border ? `border-width: ${borderWidth ?? 2}px;` : ''}`}
    {...(wrapAttrs as any)}
  >
    <img
      src={src}
      srcset={srcset}
      sizes="(max-width: 900px) 100vw, 900px"
      alt={alt}
      loading={isHero ? 'eager' : 'lazy'}
      fetchpriority={isHero ? 'high' : undefined}
      style={`object-position: ${focalX ?? 50}% ${focalY ?? 50}%;`}
    />
  </Wrap>
  {caption && <figcaption class="figure__caption">{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 1.5rem 0;
  }

  .figure--narrow {
    margin-left: auto;
    margin-right: auto;
  }

  .figure__frame {
    display: block;
    overflow: hidden;
    background: var(--line);
    /* Fallback for when no `aspect` is supplied (e.g. an upload whose
       dimensions weren't captured) — without this, the img's height:100%
       has no basis to resolve against and the figure collapses to
       nothing, so the image silently fails to show. */
    aspect-ratio: 3 / 2;
  }

  a.figure__frame:hover img {
    opacity: 0.88;
  }

  .figure__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s ease;
  }

  .figure--hero .figure__frame {
    max-height: 85vh;
  }

  .figure__frame--bordered {
    border-style: solid;
    border-color: var(--ink);
  }

  .figure__frame--matted {
    box-sizing: border-box;
    padding: 14px;
    background: #fff;
  }

  .figure__caption {
    margin-top: 0.5rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
    font-style: italic;
  }
</style>
