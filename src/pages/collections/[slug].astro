---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { responsiveSrcSet } from '../../lib/images';

export async function getStaticPaths() {
  const allEntries = await getCollection('entries');
  const slugs = new Set<string>();
  allEntries.forEach((entry) => (entry.data.collections ?? []).forEach((slug) => slugs.add(slug)));

  return Array.from(slugs).map((slug) => ({
    params: { slug },
    props: {
      entries: allEntries.filter((entry) => (entry.data.collections ?? []).includes(slug)),
    },
  }));
}

interface Props {
  entries: CollectionEntry<'entries'>[];
}

const { slug } = Astro.params;
const { entries: rawEntries } = Astro.props;
const entries = rawEntries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title={`${slug} — bichette`}>
  <div class="wrap collection">
    <header class="collection__header">
      <span class="eyebrow">collection</span>
      <h1 class="collection__title">{slug}</h1>
    </header>

    <div class="collection__grid">
      {entries.map((entry, i) => {
        const { title, type, image, imageAlt, aspect, caption } = entry.data;
        return (
          <a class="item" href={`/entries/${entry.slug}`}>
            {image && (
              <div class="item__frame" style={aspect ? `aspect-ratio: ${aspect};` : ''}>
                <img
                  src={image}
                  srcset={responsiveSrcSet(image)}
                  sizes="(max-width: 640px) 100vw, (max-width: 1020px) 50vw, 33vw"
                  alt={imageAlt ?? title ?? ''}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
              </div>
            )}
            <div class="item__text">
              <span class="eyebrow">{type}</span>
              {title && <span class="item__title">{title}</span>}
              {caption && <span class="item__caption">{caption}</span>}
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .collection {
    padding-top: 2.5rem;
    padding-bottom: 5rem;
  }

  .collection__header {
    margin-bottom: 2rem;
  }

  .collection__title {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    margin-top: 0.4rem;
    text-transform: lowercase;
  }

  /* Same multi-column approach the original homepage used — items of
     different heights settle next to each other without a JS library. */
  .collection__grid {
    column-count: 1;
    column-gap: var(--gutter);
  }

  @media (min-width: 640px) {
    .collection__grid {
      column-count: 2;
    }
  }

  @media (min-width: 1020px) {
    .collection__grid {
      column-count: 3;
    }
  }

  .item {
    display: block;
    break-inside: avoid;
    margin-bottom: var(--gutter);
    text-decoration: none;
  }

  .item__frame {
    overflow: hidden;
    background: var(--line);
  }

  .item__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s ease;
  }

  .item:hover .item__frame img {
    opacity: 0.88;
  }

  .item__text {
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .item__title {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--ink);
  }

  .item__caption {
    font-size: 0.82rem;
    color: var(--ink-soft);
    font-style: italic;
  }
</style>
