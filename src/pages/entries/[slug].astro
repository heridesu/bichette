---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Figure from '../../components/Figure.astro';
import FigureGrid from '../../components/FigureGrid.astro';
import ContactSheet from '../../components/ContactSheet.astro';
import { itemZ, tapeClipPath, tapeHeightPercent, youtubeEmbedId } from '../../lib/decorations';
import { responsiveSrcSet } from '../../lib/images';

export async function getStaticPaths() {
  const entries = await getCollection('entries');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'entries'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, image, imageAlt, aspect, caption, location, url, tags, pageStyle, detailImage, detailImageAlt, note } =
  entry.data;

// Two experiences sharing one template, not two separate page types:
// an entry with no body text at all (most single-photo entries) gets a
// restrained, gallery-label treatment; anything with actual writing,
// multiple figures, a list, etc. gets the fuller article treatment.
// What decides it is only how much is actually there — nothing here is
// hand-assigned per entry.
//
// `date` exists on every entry (it's what sorts the homepage and
// collections) but is never displayed here — only content the user
// actually wrote (title, location, caption, body, tags) appears on the
// page itself.
const hasBody = entry.body.trim().length > 0;
const isMinimal = !hasBody;
const collage = entry.data.template === 'collage' ? entry.data.collage : undefined;
const contactSheet = entry.data.template === 'contact-sheet' ? entry.data.contactSheet : undefined;

// A collage tile is either a lightbox trigger (its own image, opened
// full-screen in place — same mechanism and script as the homepage's
// "Full image" link type, see Lightbox.astro), a link (its own `href`
// set), or neither — same external-link handling as the homepage's own
// tileAttrs().
function tileWrapper(tile: { href?: string; kind: string; lightbox?: boolean; src?: string; alt?: string }) {
  if (tile.kind === 'image' && tile.lightbox) {
    return {
      tag: 'div' as const,
      attrs: {
        role: 'button',
        tabindex: 0,
        'data-lightbox-src': tile.src,
        'data-lightbox-alt': tile.alt ?? '',
        'aria-label': 'View image full size',
      },
    };
  }
  if (!tile.href) return { tag: 'div' as const, attrs: {} };
  const external = tile.href.startsWith('http');
  return {
    tag: 'a' as const,
    attrs: { href: tile.href, target: external ? '_blank' : undefined, rel: external ? 'noopener noreferrer' : undefined },
  };
}
---

<BaseLayout title={title ? `${title} — bichette` : 'bichette'}>
  {collage ? (
    <div class="wrap collage-page">
      {title && <h1 class="collage-page__title">{title}</h1>}
      {collage.sections.map((section, i) => (
        <div
          class={`deco-canvas${section.fullBleed ? ' deco-canvas--full-bleed' : ''}`}
          style={`aspect-ratio:${section.canvasWidth}/${section.canvasHeight};${i > 0 ? 'margin-top:3rem;' : ''}`}
        >
          {section.tiles.map((tile, ti) => {
            // A text tile a template placed but the user never wrote
            // into — Studio shows a subtle "Add a caption…" hint for
            // these, but the public site never ships an empty one as if
            // it were real content.
            if (tile.kind === 'text' && !tile.text.trim()) return null;
            const { tag: Tag, attrs } = tileWrapper(tile);
            const clickable = tile.href || (tile.kind === 'image' && tile.lightbox);
            // Only the very first tile of the first section gets eager
            // loading — a collage section can hold many overlapping
            // tiles, and marking all of them high-priority would defeat
            // the point of prioritizing anything.
            const eager = i === 0 && ti === 0;
            const matPadding = tile.mat ? `padding:${tile.matPadding ?? 14}px;` : '';
            const borderWidth = tile.border ? `border-width:${tile.borderWidth ?? 2}px;` : '';
            return (
              <Tag
                class={`deco-tile${clickable ? ' deco-tile--linked' : ''}${tile.border ? ' deco-tile--bordered' : ''}${tile.mat ? ' deco-tile--matted' : ''}`}
                style={`left:${tile.left}%;top:${tile.top}%;width:${tile.width}%;height:${tile.height}%;z-index:${itemZ('tile', tile)};${matPadding}${borderWidth}`}
                {...(attrs as any)}
              >
                {tile.kind === 'image' && (
                  <img
                    src={tile.src}
                    srcset={responsiveSrcSet(tile.src)}
                    sizes="(max-width: 900px) 100vw, 900px"
                    alt={tile.alt ?? ''}
                    loading={eager ? 'eager' : 'lazy'}
                    fetchpriority={eager ? 'high' : undefined}
                    style={`object-position: ${tile.focalX ?? 50}% ${tile.focalY ?? 50}%;`}
                  />
                )}
                {tile.kind === 'video' && <video src={tile.src} controls playsinline preload="metadata" />}
                {tile.kind === 'youtube' && tile.url && (
                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${youtubeEmbedId(tile.url)}`}
                    title="YouTube video"
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  />
                )}
                {tile.kind === 'text' && (
                  <div
                    class={`deco-tile__text${tile.textSize && tile.textSize !== 'body' ? ` deco-tile__text--${tile.textSize}` : ''}${tile.uppercase ? ' deco-tile__text--uppercase' : ''}`}
                  >
                    {tile.text}
                  </div>
                )}
              </Tag>
            );
          })}
          {section.tape.map((piece) => (
            <div
              class="deco-tape"
              style={`left:${piece.left}%;top:${piece.top}%;width:${piece.width}%;height:${tapeHeightPercent(piece, section.canvasWidth, section.canvasHeight)}%;z-index:${itemZ('tape', piece)};--tape-color:${piece.color};transform:rotate(${piece.rotation}deg);clip-path:${tapeClipPath(piece.torn, piece.tornSeed)};`}
            />
          ))}
          {section.tacks.map((tack) => (
            <img
              class="deco-tack"
              src="/decorations/tack-silver.png"
              alt=""
              style={`left:${tack.left}%;top:${tack.top}%;z-index:${itemZ('tack', tack)};`}
            />
          ))}
        </div>
      ))}
    </div>
  ) : contactSheet ? (
    <div class={`wrap contact-sheet-page${contactSheet.widthDesktop === 'normal' ? ' contact-sheet-page--normal' : ''}`}>
      {title && <h1 class="contact-sheet-page__title">{title}</h1>}
      <ContactSheet data={contactSheet} groupId={entry.slug} />
    </div>
  ) : isMinimal ? (
    <article class={`wrap entry-minimal${pageStyle ? ` entry-minimal--${pageStyle}` : ''}`}>
      {title && <p class="entry-minimal__title">{title}</p>}

      {image && (
        <div class="entry-minimal__frame" style={aspect ? `aspect-ratio: ${aspect};` : ''}>
          <img
            src={image}
            srcset={responsiveSrcSet(image)}
            sizes="(max-width: 900px) 100vw, 900px"
            alt={imageAlt ?? title ?? ''}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )}

      {caption && <p class="entry-minimal__caption">{caption}</p>}

      {detailImage && (
        <div class="entry-minimal__detail">
          <img src={detailImage} srcset={responsiveSrcSet(detailImage)} sizes="40vw" alt={detailImageAlt ?? ''} loading="lazy" />
        </div>
      )}

      {note && <p class="entry-minimal__note">{note}</p>}

      {location && <p class="entry-minimal__meta">{location}</p>}

      {url && (
        <a class="entry-minimal__visit" href={url} target="_blank" rel="noopener noreferrer">
          visit the source ↗
        </a>
      )}

      {tags && tags.length > 0 && (
        <ul class="entry-minimal__tags">
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </article>
  ) : (
    <article class={`wrap entry-page${pageStyle ? ` entry-page--${pageStyle}` : ''}`}>
      {title && <h1 class="entry-page__title">{title}</h1>}
      {location && <p class="entry-page__location">{location}</p>}

      {image && (
        <Figure src={image} alt={imageAlt ?? title ?? ''} aspect={aspect} caption={caption} size="hero" />
      )}

      {!image && caption && <p class="entry-page__standalone-caption">{caption}</p>}

      <div class="entry-page__body">
        <Content components={{ Figure, FigureGrid }} />
      </div>

      {url && (
        <a class="entry-page__visit" href={url} target="_blank" rel="noopener noreferrer">
          visit the source ↗
        </a>
      )}

      {tags && tags.length > 0 && (
        <ul class="entry-page__tags">
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </article>
  )}
</BaseLayout>

<style>
  /* Minimal mode: one photograph (or object), generous whitespace, a
     quiet label instead of an article header. The image shows whole
     (object-fit: contain) rather than cropped to a frame, since there's
     no grid to fit into here. */
  .entry-minimal {
    max-width: 44rem;
    padding-top: 4rem;
    padding-bottom: 7rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .entry-minimal__title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--ink-soft);
    margin-bottom: 2rem;
  }

  .entry-minimal__frame {
    width: 100%;
    max-height: 78vh;
    aspect-ratio: 3 / 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .entry-minimal__frame img {
    width: 100%;
    height: 100%;
    max-height: 78vh;
    object-fit: contain;
    display: block;
  }

  .entry-minimal__caption {
    margin-top: 1.5rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
    font-style: italic;
    max-width: 32rem;
  }

  .entry-minimal__detail {
    width: 40%;
    margin-top: 2rem;
  }

  .entry-minimal__detail img {
    width: 100%;
    display: block;
  }

  .entry-minimal__note {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--ink-faint);
    font-style: italic;
    max-width: 28rem;
  }

  /* Object Study: the caption/note read as a quiet handwritten-ish
     annotation rather than a formal caption — serif instead of the
     site's default sans, no new font loaded. */
  .entry-minimal--object-study .entry-minimal__caption,
  .entry-minimal--object-study .entry-minimal__note,
  .entry-page--object-study :global(.figure__caption) {
    font-family: var(--font-serif);
  }

  /* Photo Essay: more breathing room between figures, title kept quiet
     so the photographs carry the page. */
  .entry-page--photo-essay .entry-page__body :global(.figure) {
    margin: 2.5rem 0;
  }

  .entry-page--photo-essay .entry-page__title {
    font-size: 1.3rem;
    font-weight: 400;
  }

  /* Editorial Article: a more pronounced, magazine-style headline. */
  .entry-page--editorial .entry-page__title {
    font-size: 2.3rem;
  }

  .entry-minimal__meta {
    margin-top: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .entry-minimal__visit {
    display: inline-block;
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .entry-minimal__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin: 1.5rem 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-faint);
    text-transform: lowercase;
  }

  /* Richer mode: title, writing, possibly multiple figures — the fuller
     article treatment. */
  .entry-page {
    max-width: 48rem;
    padding-top: 2.5rem;
    padding-bottom: 5rem;
  }

  .entry-page__title {
    font-family: var(--font-serif);
    font-size: 1.9rem;
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }

  .entry-page__location {
    font-size: 0.85rem;
    color: var(--ink-faint);
    margin-bottom: 0.5rem;
  }

  .entry-page__standalone-caption {
    font-size: 1.05rem;
    color: var(--ink-soft);
    font-style: italic;
    margin: 1.25rem 0;
  }

  .entry-page__body {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .entry-page__body :global(p) {
    margin: 1rem 0 0;
  }

  .entry-page__body :global(p:first-child) {
    margin-top: 0;
  }

  .entry-page__body :global(ul),
  .entry-page__body :global(ol) {
    margin: 1rem 0 0;
    padding-left: 1.3rem;
  }

  .entry-page__visit {
    display: inline-block;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .entry-page__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 2rem 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-faint);
    text-transform: lowercase;
  }

  @media (max-width: 560px) {
    .entry-minimal {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }
  }

  .collage-page {
    max-width: var(--max-width);
    padding-top: 2.5rem;
    padding-bottom: 5rem;
  }

  .collage-page__title {
    font-family: var(--font-serif);
    font-size: 1.9rem;
    line-height: 1.2;
    margin-bottom: 1.5rem;
  }

  .contact-sheet-page {
    max-width: var(--max-width);
    padding-top: 2.5rem;
    padding-bottom: 5rem;
  }

  /* Narrows the desktop column to match a Standard article's body width
     instead of the full wide column. Mobile is unaffected either way —
     its own viewport is already narrower than 48rem. */
  .contact-sheet-page--normal {
    max-width: 48rem;
  }

  .contact-sheet-page__title {
    font-family: var(--font-serif);
    font-size: 1.9rem;
    line-height: 1.2;
    margin-bottom: 1.5rem;
  }
</style>
