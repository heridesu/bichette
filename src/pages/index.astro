---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import layout from '../data/homepage-layout.json';
import { responsiveSrcSet } from '../lib/images';

// The homepage is a deliberately art-directed composition, not a generic
// grid. Its geometry lives in src/data/homepage-layout.json rather than
// here — that's what the Bichette Studio editor (src/pages/studio/) reads
// and writes, so arranging the homepage doesn't require touching code.
// This file only resolves that data against real content and renders it.
const allEntries = await getCollection('entries');
const bySlug = Object.fromEntries(allEntries.map((entry) => [entry.slug, entry]));

interface LinkSpec {
  type: 'entry' | 'collection' | 'url' | 'none' | 'lightbox';
  slug?: string;
  href?: string;
}

// Decides how a tile behaves on click: a real navigation (entry page,
// collection, external URL), a full-screen view of the image in place
// (no navigation at all), or nothing. `Lightbox.astro` (included once in
// BaseLayout) is what actually opens the image for the `lightbox` case —
// this just marks the element for it via data attributes.
function tileAttrs(link: LinkSpec | undefined, entry: (typeof allEntries)[number]) {
  const type = link?.type ?? 'entry';

  if (type === 'lightbox') {
    return {
      tag: 'div' as const,
      attrs: {
        role: 'button',
        tabindex: 0,
        'data-lightbox-src': entry.data.image,
        'data-lightbox-alt': entry.data.imageAlt ?? '',
        'aria-label': `View ${entry.data.title ?? 'image'} full size`,
      },
      clickable: true,
    };
  }

  let href: string | null = null;
  if (type === 'entry') href = `/entries/${entry.slug}`;
  else if (type === 'collection' && link?.slug) href = `/collections/${link.slug}`;
  else if (type === 'url' && link?.href) href = link.href;

  if (!href) return { tag: 'div' as const, attrs: {}, clickable: false };

  return {
    tag: 'a' as const,
    attrs: {
      href,
      target: href.startsWith('http') ? '_blank' : undefined,
      rel: href.startsWith('http') ? 'noopener noreferrer' : undefined,
      'aria-label': entry.data.title ?? 'View entry',
    },
    clickable: true,
  };
}
---

<BaseLayout>
  <div class="wrap collage-wrap">
    {layout.desktopSections.map((section, i) => (
      <div
        class="collage collage--desktop"
        style={`aspect-ratio:${section.canvasWidth}/${section.canvasHeight};${i > 0 ? 'margin-top:3rem;' : ''}`}
      >
        {section.tiles.map((item, ti) => {
          const entry = bySlug[item.slug];
          if (!entry) return null;
          const { tag: Tag, attrs, clickable } = tileAttrs(item.link as LinkSpec, entry);
          const style = `left:${item.left}%;top:${item.top}%;width:${item.width}%;height:${item.height}%;z-index:${item.z ?? 1};`;
          // Only the first section is reliably above the fold — its
          // tiles load promptly, everything after stays lazy. Only ONE
          // image per page should be fetchpriority="high" (the LCP
          // candidate), so that's reserved for just the very first tile.
          const eager = i === 0;
          const highPriority = i === 0 && ti === 0;
          return (
            <Tag class={`tile${clickable ? ' tile--clickable' : ''}`} style={style} {...(attrs as any)}>
              <img
                src={entry.data.image}
                srcset={entry.data.image ? responsiveSrcSet(entry.data.image) : undefined}
                sizes="(max-width: 860px) 100vw, 50vw"
                alt={entry.data.imageAlt ?? ''}
                loading={eager ? 'eager' : 'lazy'}
                fetchpriority={highPriority ? 'high' : undefined}
              />
            </Tag>
          );
        })}
      </div>
    ))}

    <div class="collage collage--mobile">
      {layout.mobileSections.flatMap((section) => section.rows).map((row, i) => (
        <div class="collage__row">
          {row.map((item, ti) => {
            const entry = bySlug[item.slug];
            if (!entry) return null;
            const { tag: Tag, attrs, clickable } = tileAttrs(item.link as LinkSpec, entry);
            const style = `width:${item.width}%;aspect-ratio:${item.aspect};`;
            const eager = i === 0;
            const highPriority = i === 0 && ti === 0;
            return (
              <Tag
                class={`tile tile--mobile${clickable ? ' tile--clickable' : ''}${item.align ? ` tile--${item.align}` : ''}`}
                style={style}
                {...(attrs as any)}
              >
                <img
                  src={entry.data.image}
                  srcset={entry.data.image ? responsiveSrcSet(entry.data.image) : undefined}
                  sizes={`${item.width}vw`}
                  alt={entry.data.imageAlt ?? ''}
                  loading={eager ? 'eager' : 'lazy'}
                  fetchpriority={highPriority ? 'high' : undefined}
                />
              </Tag>
            );
          })}
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .collage-wrap {
    padding-top: 1.5rem;
    padding-bottom: 5rem;
  }

  .tile {
    display: block;
    overflow: hidden;
    background: var(--line);
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s ease;
  }

  .tile--clickable {
    cursor: pointer;
  }

  .tile--clickable:hover img {
    opacity: 0.88;
  }

  /* Desktop: explicit placement on a fixed-proportion canvas (matching
     the Paper frame's own 1440×1840 artboard). Percentages mean the
     whole composition scales fluidly — no media queries needed until
     the mobile breakpoint takes over entirely. */
  .collage--desktop {
    display: none;
  }

  @media (min-width: 860px) {
    .collage--desktop {
      display: block;
      position: relative;
      width: 100%;
    }

    .collage--desktop .tile {
      position: absolute;
    }

    .collage--mobile {
      display: none;
    }
  }

  /* Mobile / narrow tablet: a separate hand-composed flow, not the
     desktop layout scaled down. Rows vary in item count and width so
     sizes stay irregular instead of flattening to uniform cards. */
  .collage--mobile {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .collage__row {
    display: flex;
    gap: 0.9rem;
  }

  .tile--mobile.tile--end {
    align-self: flex-end;
    margin-top: 2.5rem;
  }

  .tile--mobile.tile--center {
    margin: 0 auto;
  }
</style>
